# Public in the browser. These two Supabase values are safe only with RLS on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ASSET_BASE_URL=https://your-bucket.s3.amazonaws.com/

# Server-side only. Never add NEXT_PUBLIC_ to any of these names.
SUPABASE_SERVICE_ROLE_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
